# The binary fixtures must not be rewritten by an end-of-line filter. A file
# that happens to hold no NUL byte is otherwise taken for text, and the CRLF
# conversion corrupts it: the constant u16 planes are exactly that case -
# 0x0A bytes, so every second byte became a line ending on checkout.
*.bin -text
*.raw -text
*.tif -text
*.jxr -text

# Everything under tests/fixtures/ is test input, not source. The data files
# are the four binary extensions above and stay byte for byte; the manifests
# and the generators beside them are text, and are kept with LF line endings
# on every platform, so that a fixture means the same thing everywhere: the
# generators write the manifests in text mode, which on Windows means CRLF,
# and a CRLF manifest would differ from the committed one on every platform.
# The CI check .github/scripts/check-gitattributes.sh asks for `text: unset`
# on every binary file and for `text: set` with `eol: lf` on every text
# fixture, so a fixture added later cannot be rewritten by an end-of-line
# filter without being named here first.
tests/fixtures/**/manifest.json text eol=lf
tests/fixtures/**/gen_*_fixtures.py text eol=lf

# The workflow and its scripts are read by the workflow parser and by bash,
# and neither of them wants CRLF: a shell script with CRLF line endings fails
# on the runner that checks it out.
.github/** text eol=lf

# The vendored jxrlib tree is kept byte for byte as upstream shipped it at
# 19cc1fa19ca6607449d210aea946b3187f808f2c, apart from the patches recorded
# in vendor/jxrlib/PATCHES.md. The tree is not UTF-8: the C sources
# and headers are Windows-1252 (a 0xA9 sign and 0x95 bullets), doc/readme.txt
# carries 0x93, 0x94 and 0x99, the .vcxproj files are UTF-8 with a BOM,
# Makefile.reference carries upstream's own U+FFFD bytes, and PATCHES.md and
# LICENSE are UTF-8. An end-of-line filter would rewrite them, so the tree is
# marked as binary.
vendor/** -text
